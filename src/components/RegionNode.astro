---
import RegionNode from './RegionNode.astro';
import { url } from '../lib/url';
import {
  childrenOfPlace,
  placeMap,
  placeTierMap,
  membersOfPlace,
  headsOfPlace,
  loreOfPlace,
} from '../lib/loadData';

interface Props {
  regionId: string;
  depth: number;
}

const { regionId, depth } = Astro.props;
const rgn = placeMap.get(regionId);
const kids = rgn ? childrenOfPlace(regionId) : [];
const tier = rgn ? placeTierMap.get(rgn.tier) : null;
const people = rgn ? membersOfPlace(rgn.id) : [];
const headIds = rgn ? headsOfPlace(rgn.id) : [];
const intro = rgn ? loreOfPlace(rgn.id) : null;

const headLabel = (t: string) =>
  t === 'region' ? '主任' : t === 'commune' ? '代表' : '负责';
---

{
  rgn && (
    <div class="rgn-node" id={`rgn-${rgn.id}`} style={`--rd:${depth}`}>
      <article class={`rgn-card rgn-card--${rgn.tier}`}>
        <div class="rgn-card-head">
          <span class="rgn-tier-tag">{tier?.name ?? ''}</span>
          <h3 class="rgn-name">
            {
              intro ? (
                <a class="place-link" href={url('/lore/') + '#region-' + intro.id}>
                  {rgn.name}
                  <span class="place-link-mark" aria-hidden="true">介绍</span>
                </a>
              ) : (
                rgn.name
              )
            }
          </h3>
        </div>

        {rgn.summary && <p class="rgn-summary">{rgn.summary}</p>}

        {people.length > 0 && (
          <div class="rgn-people">
            {people.map((m) => {
              const isHead = headIds.includes(m.id);
              return (
                <a class="rgn-person" href={url(`/members/${m.id}`)}>
                  <span class="rgn-person-name">{m.displayName}</span>
                  {isHead && <span class="rgn-person-role">{headLabel(rgn.tier)}</span>}
                </a>
              );
            })}
          </div>
        )}
      </article>

      {kids.length > 0 && (
        <div class="rgn-children">
          {kids.map((k) => (
            <RegionNode regionId={k.id} depth={depth + 1} />
          ))}
        </div>
      )}
    </div>
  )
}

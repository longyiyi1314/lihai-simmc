---
import type { Portfolio } from '../lib/types';
import { roleHueOf } from '../lib/theme';

interface Props {
  role: Portfolio;
  icon?: boolean;
  class?: string;
}

const { role, icon = false, class: cls = '' } = Astro.props;
const hue = roleHueOf(role.id);
---

<span class={['role-tag', icon ? 'role-tag--icon' : '', cls].filter(Boolean).join(' ')} style={`--rh:${hue}`}>
  {icon && role.icon ? <span class="ico" aria-hidden="true">{role.icon}</span> : <span class="role-dot"></span>}
  <span>{role.name}</span>
</span>

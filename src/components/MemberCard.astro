---
import type { Member } from '../lib/types';
import { rankMap, officesOf, formatMonth, statusLabel, isPlaceholder } from '../lib/loadData';
import { url } from '../lib/url';
import { hueOf } from '../lib/theme';
import Avatar from './Avatar.astro';
import RankBadge from './RankBadge.astro';

interface Props {
  member: Member;
  /** 是否显示简介段落 */
  showIntro?: boolean;
}

const { member, showIntro = true } = Astro.props;

const rank = rankMap.get(member.rankId);
const offices = officesOf(member.id);
const hue = hueOf(member.id);
const isAlumni = member.status === 'honorary' || member.status === 'left';

/**
 * 副标题：称号 → 级别 → 游戏 ID。
 * 称号若与职级名相同（多数成员如此），显示级别，避免与右侧徽章重复。
 */
const subTitle = (() => {
  if (member.title && member.title !== rank?.name) return member.title;
  if (rank?.grade) return rank.grade;
  return member.gameId;
})();
---

<article class="mcard" style={`--h:${hue}`}>
  <a class="mcard-link" href={url(`/members/${member.id}/`)} aria-label={`${member.displayName} 的成员资料`}>
    <div class="mcard-top">
      <Avatar seed={member.id} name={member.displayName} src={member.avatar} size="md" />
      <div class="mcard-id">
        <span class="mcard-name">{member.displayName}</span>
        <span class={subTitle === member.gameId ? 'mcard-title mcard-gid' : 'mcard-title'}>{subTitle}</span>
      </div>
      {rank && <RankBadge rank={rank} size="sm" />}
    </div>

    {showIntro && member.intro && <p class="mcard-intro">{member.intro}</p>}

    <div class="mcard-foot">
      <div class="mcard-roles">
        {offices.length
          ? offices.slice(0, 2).map((n) => (
              <span class="role-tag">
                <span class="role-dot" aria-hidden="true" />
                {n.name}
              </span>
            ))
          : <span class="mcard-since mcard-none">未列机构</span>}
      </div>
      <span class="mcard-since">
        {isAlumni ? statusLabel[member.status] : member.joinedAt ? `加入 ${formatMonth(member.joinedAt)}` : member.gameId}
      </span>
    </div>
  </a>
  {isPlaceholder && member.status === 'reserve' && <span class="mcard-flag">休假</span>}
</article>

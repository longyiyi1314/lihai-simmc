---
import OrgNode from './OrgNode.astro';
import { url } from '../lib/url';
import {
  childrenOf,
  organizationMap,
  orgTierMap,
  membersOfOrg,
  headsOfOrg,
} from '../lib/loadData';

interface Props {
  orgId: string;
  depth: number;
}

const { orgId, depth } = Astro.props;
const org = organizationMap.get(orgId);
const kids = org ? childrenOf(orgId) : [];
const tier = org ? orgTierMap.get(org.tier) : null;
const people = org ? membersOfOrg(orgId) : [];
const headIds = org ? headsOfOrg(orgId) : [];
---

{
  org && (
    <div class="org-node" id={`org-${org.id}`} style={`--od:${depth}`}>
      <article class={`org-card org-card--${org.tier}`}>
        <div class="org-card-head">
          <span class="org-tier-tag">{tier?.name ?? ''}</span>
          <h3 class="org-name">{org.name}</h3>
        </div>
        <div class="org-people">
          {people.length === 0 ? (
            <span class="org-vacant">岗位暂缺</span>
          ) : (
            people.map((m) => {
              const isHead = headIds.includes(m.id);
              return (
                <a class="org-person" href={url(`/members/${m.id}`)}>
                  <span class="org-person-name">{m.displayName}</span>
                  {isHead && <span class="org-person-role">负责</span>}
                </a>
              );
            })
          )}
        </div>
      </article>

      {kids.length > 0 && (
        <div class="org-children">
          {kids.map((k) => (
            <OrgNode orgId={k.id} depth={depth + 1} />
          ))}
        </div>
      )}
    </div>
  )
}

---
import { url } from '../lib/url';
import { site } from '../lib/loadData';

const path = (Astro.url.pathname || '').replace(/\/+$/, '') || '/';

const nav = [
  { href: url('/'), label: '首页', match: '/' },
  { href: url('/members/'), label: '成员', match: '/members' },
  { href: url('/ranks/'), label: '职级', match: '/ranks' },
  { href: url('/organization/'), label: '机构', match: '/organization' },
  { href: url('/regions/'), label: '地区', match: '/regions' },
  { href: url('/territory/'), label: '疆域', match: '/territory' },
  { href: url('/lore/'), label: '地区介绍', match: '/lore' },
  { href: url('/about/'), label: '关于', match: '/about' },
];

const base = url('').replace(/\/+$/, '');
const isCurrent = (match: string) => {
  const p = path.slice(base.length) || '/';
  if (match === '/') return p === '/';
  return p === match || p.startsWith(match + '/');
};
---

<header class="site-header">
  <div class="wrap">
    <a class="brand" href={url('/')} aria-label={`${site.nationName} 首页`}>
      <span class="brand-mark" aria-hidden="true"></span>
      <span class="brand-text">
        <span class="brand-name">{site.nationName}</span>
        <span class="brand-en">{site.nationNameEn || site.server}</span>
      </span>
    </a>

    <nav class="nav" aria-label="主导航">
      {
        nav.map((n) => (
          <a
            class="nav-link"
            href={n.href}
            aria-current={isCurrent(n.match) ? 'page' : undefined}
          >
            {n.label}
          </a>
        ))
      }
    </nav>

    {
      site.recruiting && (
        <a class="header-cta" href={url('/about/#join')}>
          <span class="dot" aria-hidden="true" />
          招募中
        </a>
      )
    }

    <button
      class="theme-toggle"
      type="button"
      data-theme-toggle
      aria-label="切换到亮色配色"
      title="切换到亮色配色"
    >
      <span class="theme-toggle-ico" aria-hidden="true"></span>
    </button>
  </div>
</header>

<script is:inline>
  (function () {
    var btn = document.querySelector('[data-theme-toggle]');
    if (!btn) return;

    var root = document.documentElement;
    var meta = document.getElementById('theme-color');
    var LIGHT = 'light';

    function current() {
      return root.getAttribute('data-theme') === LIGHT ? LIGHT : 'dark';
    }

    function paint(theme) {
      var light = theme === LIGHT;
      root.setAttribute('data-theme', theme);
      if (meta) meta.setAttribute('content', light ? '#f6efe9' : '#060c10');
      var label = light ? '切换到暗色配色' : '切换到亮色配色';
      btn.setAttribute('aria-label', label);
      btn.setAttribute('title', label);
    }

    paint(current());

    btn.addEventListener('click', function () {
      var next = current() === LIGHT ? 'dark' : LIGHT;
      try {
        localStorage.setItem('lihai-theme', next);
      } catch (e) {
        /* 存储不可用时仍然切换当前页 */
      }
      paint(next);
    });
  })();
</script>

---
import { site } from '../lib/loadData';
import { url } from '../lib/url';

const year = new Date().getFullYear();
const founded = site.foundedAt ? site.foundedAt.replace('-', '.') : '';
---

<footer class="site-footer">
  <div class="wrap">
    <h2 class="visually-hidden">站内导航与档案</h2>
    <div class="foot-top">
      <div class="foot-brand-col">
        <div class="foot-brand">
          <span class="brand-mark" aria-hidden="true"></span>
          <span class="brand-text">
            <span class="brand-name">{site.nationName}</span>
          </span>
        </div>
        {site.motto && <p class="foot-motto">{site.motto}</p>}
        <p class="foot-note">
          {site.server}{site.version ? ` ${site.version}` : ''} 国家成员站 · 收录成员、职位与沿革。
        </p>
      </div>

      <div class="foot-col">
        <h3>浏览</h3>
        <ul>
          <li><a href={url('/')}>首页</a></li>
          <li><a href={url('/members/')}>成员名单</a></li>
          <li><a href={url('/ranks/')}>职位体系</a></li>
        </ul>
      </div>

      <div class="foot-col">
        <h3>了解</h3>
        <ul>
          <li><a href={url('/about/')}>关于璃海</a></li>
          <li><a href={url('/about/#story')}>建城沿革</a></li>
          <li><a href={url('/about/#join')}>加入方式</a></li>
        </ul>
      </div>

      <div class="foot-col foot-col--wide">
        <h3>档案</h3>
        <ul>
          <li><span>{site.game}</span></li>
          <li><span>{site.server}</span></li>
          <li><span class="mono">{founded || '—'}</span></li>
        </ul>
      </div>
    </div>

    <div class="foot-bottom">
      <span>© {year} {site.nationName} · {site.server}</span>
      <span class="mono">
        琉璃澄澈<span class="foot-dot">/</span>历久不蚀
      </span>
    </div>
  </div>
</footer>

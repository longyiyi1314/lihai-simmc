---
import { site } from '../lib/loadData';
import { url } from '../lib/url';

const year = new Date().getFullYear();
const founded = site.foundedAt ? site.foundedAt.slice(0, 4) : '';
---

<footer class="site-footer">
  <div class="wrap">
    <h2 class="visually-hidden">站内导航与档案</h2>
    <div class="foot-top">
      <div class="foot-brand-col">
        <div class="foot-brand">
          <span class="brand-mark" aria-hidden="true"></span>
          <span class="brand-text">
            <span class="brand-name">{site.nationName}</span>
            <span class="brand-en">{site.nationNameEn}</span>
          </span>
        </div>
        {site.fullName && <p class="foot-fullname">{site.fullName}</p>}
        {site.motto && <p class="foot-motto">「{site.motto}」</p>}
        <p class="foot-note">
          {site.server}{site.version ? ` ${site.version}` : ''} · {site.clubName || site.nationName}
          {site.studioName ? ` / ${site.studioName}` : ''}
        </p>
      </div>

      <div class="foot-col">
        <h3>浏览</h3>
        <ul>
          <li><a href={url('/')}>首页</a></li>
          <li><a href={url('/members/')}>成员名录</a></li>
          <li><a href={url('/system/')}>建制</a></li>
        </ul>
      </div>

      <div class="foot-col">
        <h3>土地</h3>
        <ul>
          <li><a href={url('/territory/')}>疆域</a></li>
          <li><a href={url('/territory/') + '#admin'}>行政区划</a></li>
          <li><a href={url('/lore/')}>风物</a></li>
        </ul>
      </div>

      <div class="foot-col foot-col--wide">
        <h3>档案</h3>
        <ul>
          <li><a href={url('/about/')}>关于璃海</a></li>
          <li><span>{site.government}</span></li>
          <li><span class="mono">EST. {founded}</span></li>
        </ul>
      </div>
    </div>

    <div class="foot-bottom">
      <span>© {year} {site.fullName || site.nationName} · {site.server}</span>
      <span class="mono">
        {site.slogan || '追求真理，创造奇迹'}
      </span>
    </div>
  </div>
</footer>

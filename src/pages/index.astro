---
import Base from '../layouts/Base.astro';
import MemberCard from '../components/MemberCard.astro';
import SectionHead from '../components/SectionHead.astro';
import {
  site,
  rankList,
  roleList,
  memberList,
  activeMembers,
  featuredMembers,
  membersOfRank,
  territoryList,
  territoryTiers,
  territoriesOfTier,
  isPlaceholder,
  placeholderNotice,
} from '../lib/loadData';
import { url } from '../lib/url';
import { pct, roleHueOf } from '../lib/theme';
import type { Role } from '../lib/types';

const foundedYear = site.foundedAt ? site.foundedAt.slice(0, 4) : '—';
const foundedFull = site.foundedAt ? site.foundedAt.replaceAll('-', '.') : '—';
const announcements = site.announcements.slice(0, 3);
const maxRankCount = Math.max(1, ...rankList.map((r) => membersOfRank(r.id).length));

const stats = [
  { num: String(site.memberTotal || memberList.length), unit: '人', label: '全社在册' },
  { num: String(memberList.length), unit: '人', label: '名录收录' },
  { num: String(territoryList.length), unit: '处', label: '已下发领地' },
  { num: String(rankList.length), unit: '级', label: '职级序列' },
];

function fmtDate(d: string) {
  return d.replaceAll('-', '.');
}
---

<Base description={`${site.fullName || site.nationName} · ${site.server} 国家成员站：成员名单、职级体系、疆域与联盟沿革。`}>
  <section class="hero">
    <div class="hero-bg" aria-hidden="true">
      <span class="hero-orb hero-orb--a"></span>
      <span class="hero-orb hero-orb--b"></span>
      <span class="hero-grid"></span>
      <span class="hero-sea"></span>
      <span class="hero-sheen"></span>
    </div>

    <div class="wrap">
      <div class="hero-inner">
        <div class="hero-copy">
          <p class="hero-eyebrow">
            <span class="tag">{site.game}</span>
            <span class="sep"></span>
            <span>{site.server}{site.version ? ` ${site.version}` : ''}</span>
            <span class="sep"></span>
            <span>EST. {foundedFull}</span>
          </p>

          <h1 class="hero-word" data-word={site.nationName}>
            <span class="hero-word-main">{site.nationName}</span>
            <span class="hero-word-en">{site.nationNameEn || 'Lihai'}</span>
          </h1>

          {site.fullName && <p class="hero-fullname">{site.fullName}</p>}
          {site.motto && <p class="hero-motto">「{site.motto}」</p>}
          <p class="hero-desc">{site.summary}</p>

          <div class="hero-actions">
            <a class="btn btn--primary" href={url('/members/')}>
              查看成员名录<span class="btn-arrow" aria-hidden="true">→</span>
            </a>
            <a class="btn btn--ghost" href={url('/territory/')}>看看疆域</a>
          </div>
        </div>

        <div class="hero-side" aria-hidden="true">
          <div class="crest">
            <span class="crest-halo"></span>
            <span class="crest-ring crest-ring--1"></span>
            <span class="crest-ring crest-ring--2"></span>
            <span class="crest-ring crest-ring--3"></span>
            <span class="crest-tick"></span>
            <span class="crest-core">
              <span class="crest-glyph">凛</span>
            </span>
            <span class="crest-caption">Soviet · Commune · Union</span>
          </div>
        </div>
      </div>

      <div class="hero-stats">
        {
          stats.map((s) => (
            <div class="stat">
              <div class="stat-num">
                {s.num}
                {s.unit && <small>{s.unit}</small>}
              </div>
              <div class="stat-label">{s.label}</div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <SectionHead
        no="01"
        title="名录上的人"
        desc={`凛海城中央公社前 ${memberList.length} 位成员，按职级由高到低排列。全社在册 ${site.memberTotal || memberList.length} 人。`}
        moreHref={url('/members/')}
        moreLabel="全部成员"
      />

      <div class="mgrid">
        {featuredMembers.map((m) => <MemberCard member={m} />)}
      </div>
    </div>
  </section>

  <section class="section" id="territory">
    <div class="wrap">
      <SectionHead
        no="02"
        title="从凛冬半岛到云大陆"
        desc={`已下发 ${territoryList.length} 处领地，另有 ${site.territoryTotal - site.territoryGranted} 处待下发，合计 ${site.territoryTotal} 处。`}
        moreHref={url('/territory/')}
        moreLabel="疆域全图"
      />

      <div class="terr-band">
        {
          territoryTiers.map((tier) => {
            const list = territoriesOfTier(tier.id);
            if (list.length === 0) return null;
            return (
              <div class="terr-row">
                <span class="terr-tier">
                  <b>{tier.name}</b>
                  <span class="terr-n mono">{list.length}</span>
                </span>
                <div class="terr-names">
                  {list.map((t) => (
                    <span class={`terr-chip terr-chip--${t.tier}`}>{t.name}</span>
                  ))}
                </div>
              </div>
            );
          })
        }
        <div class="terr-row terr-row--pending">
          <span class="terr-tier">
            <b>待下发</b>
            <span class="terr-n mono">{site.territoryTotal - site.territoryGranted}</span>
          </span>
          <div class="terr-names">
            <span class="terr-chip terr-chip--pending">已规划，尚未下发</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="ranks">
    <div class="wrap">
      <SectionHead
        no="03"
        title={`${rankList.length} 级职守`}
        desc="党务行政、苏维埃代表与武装力量三条线并行，级别越高，能拍板的事越多。"
        moreHref={url('/ranks/')}
        moreLabel="职级体系"
      />

      <div class="home-split">
        <div class="panel panel--pad">
          <div class="rlist">
            {
              rankList.map((r) => {
                const n = membersOfRank(r.id).length;
                return (
                  <div class="rlist-row" style={`--rc:${r.color}`}>
                    <span class="rlist-gem" aria-hidden="true" />
                    <div class="rlist-main">
                      <div class="rlist-top">
                        <span class="rlist-name">{r.name}</span>
                        <span class="rlist-lv">{r.grade || `LV.${r.level}`}</span>
                      </div>
                      <div class="rlist-bar" aria-hidden="true">
                        <span class="rlist-fill" style={`width:${Math.max(6, pct(n, maxRankCount))}%`} />
                      </div>
                    </div>
                    <span class="rlist-n">
                      <b>{n}</b> / {r.limit ?? '∞'}
                    </span>
                  </div>
                );
              })
            }
          </div>
        </div>

        <div class="home-side">
          <div class="panel panel--pad">
            <div class="panel-title">建国</div>
            <div class="meta-list">
              <div class="meta-row">
                <span class="meta-k">全称</span>
                <span class="meta-v">{site.fullName}</span>
              </div>
              <div class="meta-row">
                <span class="meta-k">创建</span>
                <span class="meta-v mono">{foundedFull}{site.foundedTime ? ` ${site.foundedTime}` : ''}</span>
              </div>
              <div class="meta-row">
                <span class="meta-k">首府</span>
                <span class="meta-v">{site.capital}</span>
              </div>
              <div class="meta-row">
                <span class="meta-k">政体</span>
                <span class="meta-v">{site.government}</span>
              </div>
            </div>
          </div>

          {
            announcements.length > 0 && (
              <div class="panel panel--pad">
                <div class="panel-title">公告</div>
                <div>
                  {announcements.map((a) => (
                    <div class="notice-item">
                      <span class="notice-date">{fmtDate(a.date)}</span>
                      <span class="notice-text">{a.text}</span>
                    </div>
                  ))}
                </div>
              </div>
            )
          }

          {
            isPlaceholder && (
              <p class="flag-note">
                <span aria-hidden="true">◆</span>
                {placeholderNotice}
              </p>
            )
          }
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="roles">
    <div class="wrap">
      <SectionHead
        no="04"
        title={`${roleList.length} 类职务`}
        desc="职级决定话语权，职务决定你每天在做什么。"
        moreHref={url('/ranks/#roles')}
        moreLabel="职务详情"
      />

      <div class="role-grid">
        {
          roleList.map((r: Role) => {
            const n = activeMembers.filter((m) => m.roleIds.includes(r.id)).length;
            return (
              <a class="role-card" href={url(`/ranks/#role-${r.id}`)} style={`--rh:${roleHueOf(r.id)}`}>
                <div class="role-card-head">
                  <span class="role-ico" aria-hidden="true">{r.icon || '◇'}</span>
                  <span class="role-name">{r.name}</span>
                  <span class="role-count">{n} 人</span>
                </div>
                <p class="role-desc">{r.description}</p>
              </a>
            );
          })
        }
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="wrap">
      <div class="cta-band">
        <div>
          <h2>凛冬号还在港里</h2>
          <p>
            {site.recruiting
              ? `璃海苏维埃公社联盟在 ${site.server} 持续招募。带上你愿意长期做的那件事，从劳动开始。`
              : '璃海当前暂停招募，但欢迎来凛海城看看。'}
          </p>
        </div>
        <div class="hero-actions" style="margin-top:0">
          <a class="btn btn--primary" href={url(site.recruiting ? '/about/#join' : '/members/')}>
            {site.recruiting ? '了解加入方式' : '看看大家'}<span class="btn-arrow" aria-hidden="true">→</span>
          </a>
          <a class="btn btn--ghost" href={url('/members/')}>成员名录</a>
        </div>
      </div>
    </div>
  </section>
</Base>

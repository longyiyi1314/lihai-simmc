---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Avatar from '../components/Avatar.astro';
import {
  site,
  rankList,
  orgRoot,
  orgChildren,
  orgHeadcount,
  orgChildCount,
  membersOfRank,
  isPlaceholder,
  placeholderNotice,
} from '../lib/loadData';
import { url } from '../lib/url';
import { branchHue } from '../lib/theme';

const total = rankList.reduce((n, r) => n + membersOfRank(r.id).length, 0);
const branches = orgChildren(orgRoot.id);
---

<Base
  title="职级与职务"
  description={`${site.fullName}的 ${rankList.length} 级职级序列，以及凛海局三个大委员会下的完整机构分工：从执行专员到首席执行委员，每一级都写明了职责与晋升方式。`}
>
  <PageHead
    title="职级与机构"
    crumb="职级"
    desc="职级决定你能承担多少，机构决定你在哪一件事上被需要。党务行政、苏维埃代表与武装力量三条线并行，才拼得出一个完整的璃海。"
  >
    <div class="page-meta">
      <span>职级 <b>{rankList.length}</b> 级</span>
      <span>机构 <b>{branches.length}</b> 委</span>
      <span>名录收录 <b>{total}</b> 人</span>
      <span>晋升 <b>评议与考核</b></span>
    </div>

    <nav class="roster-bar" aria-label="页面章节">
      <a class="chip" href="#ladder">职级阶梯</a>
      <a class="chip" href="#org">机构分支</a>
      <a class="chip" href={url('/org/')}>完整机构树</a>
    </nav>
  </PageHead>

  <section class="wrap section" id="ladder">
    <div class="sec-head">
      <span class="sec-no">01</span>
      <div class="sec-title">
        <h2>{rankList.length} 级职守</h2>
        <p>级别越高，能拍板的事越多，需要让出去的东西也越多。</p>
      </div>
      <span />
    </div>

    <div class="ladder">
      {
        rankList.map((rank) => {
          const holders = membersOfRank(rank.id);
          return (
            <div class="rung" style={`--rc:${rank.color}`}>
              <div class="rung-rail" aria-hidden="true">
                <span class="rung-dot" />
              </div>
              <div class="rung-card">
                <div class="rung-head">
                  {rank.grade && <span class="rung-lv">{rank.grade}</span>}
                  <h2 class="rung-name">{rank.name}</h2>
                  <span class="rung-count">
                    <b>{holders.length}</b> 人
                    {rank.limit ? ` / 上限 ${rank.limit}` : ' / 不限'}
                  </span>
                </div>
                <p class="rung-sum">{rank.summary}</p>

                <div class="rung-cols">
                  <div class="rung-col">
                    <h3>职责</h3>
                    <ul>
                      {rank.duties.map((d) => <li>{d}</li>)}
                    </ul>
                  </div>
                  <div class="rung-col">
                    <h3>晋升</h3>
                    <p>{rank.promotion}</p>
                  </div>
                  <div class="rung-col rung-col--members">
                    <h3>在任</h3>
                    {holders.length > 0 ? (
                      <div class="rung-people">
                        {holders.map((m) => (
                          <a class="rung-person" href={url(`/members/${m.id}/`)} title={m.displayName}>
                            <Avatar seed={m.id} name={m.displayName} src={m.avatar} size="sm" />
                            <span>{m.displayName}</span>
                          </a>
                        ))}
                      </div>
                    ) : (
                      <p class="rung-empty">暂无人在此职级</p>
                    )}
                  </div>
                </div>
              </div>
            </div>
          );
        })
      }
    </div>

    {
      isPlaceholder && (
        <p class="flag-note" style="margin-top:34px">
          <span aria-hidden="true">◆</span>
          {placeholderNotice}
        </p>
      )
    }
  </section>

  <section class="wrap section" id="org">
    <div class="sec-head">
      <span class="sec-no">02</span>
      <div class="sec-title">
        <h2>{branches.length} 个大委员会</h2>
        <p>凛海局之下分三条线：政务枢机管人与法，革命军事管枪，计划经济管产出。</p>
      </div>
      <span class="sec-more">
        <a href={url('/org/')}>看机构树 →</a>
      </span>
    </div>

    <div class="org-grid org-grid--tight">
      {
        branches.map((b, i) => {
          const kids = orgChildren(b.id);
          return (
            <a class="org-card" id={`org-${b.id}`} href={url(`/org/#org-${b.id}`)} style={`--oh:${branchHue(i)}`}>
              <div class="org-card-head">
                <span class="org-ico" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                <h3 class="org-name">{b.name}</h3>
                <span class="org-count">{orgHeadcount(b.id)} 人</span>
              </div>
              <p class="org-desc">{b.summary}</p>
              <div class="org-kids">
                {kids.map((k) => (
                  <span class="org-kid">{k.name}</span>
                ))}
              </div>
              <div class="org-foot">
                <span class="mono">{orgChildCount(b.id)} 个直属机构</span>
                <span class="org-arrow" aria-hidden="true">→</span>
              </div>
            </a>
          );
        })
      }
    </div>
  </section>

  <div class="wrap">
    <div class="cta-band">
      <div>
        <h2>想清楚要做哪一种人了？</h2>
        <p>职级可以慢慢升，职务可以随时换。先进来，再谈想去哪个方向。</p>
      </div>
      <a class="btn btn--primary" href={url('/about/#join')}>
        了解加入方式<span class="btn-arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</Base>

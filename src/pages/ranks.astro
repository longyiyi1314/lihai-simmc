---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Avatar from '../components/Avatar.astro';
import {
  site,
  rankList,
  roleList,
  membersOfRank,
  membersOfRole,
  isPlaceholder,
  placeholderNotice,
} from '../lib/loadData';
import { url } from '../lib/url';
import { roleHueOf } from '../lib/theme';

const total = rankList.reduce((n, r) => n + membersOfRank(r.id).length, 0);
const tracks = [
  { id: 'party', name: '党务与行政', desc: '凛海局中央执行委员会与国家各部门的职级序列。' },
  { id: 'soviet', name: '苏维埃代表', desc: '由各地区选举产生，参与地方立法与执行。' },
  { id: 'army', name: '武装力量', desc: '红军序列，承担军事防卫与开边垦荒。' },
];
---

<Base
  title="职级与职务"
  description={`${site.fullName}的 ${rankList.length} 级职级序列与 ${roleList.length} 类职务分工：从执行专员到首席执行委员，每一级都写明了职责与晋升方式。`}
>
  <PageHead
    title="职级与职务"
    crumb="职级"
    desc="职级决定你能承担多少，职务决定你在哪一件事上被需要。党务行政、苏维埃代表与武装力量三条线并行，才拼得出一个完整的璃海。"
  >
    <div class="page-meta">
      <span>职级 <b>{rankList.length}</b> 级</span>
      <span>职务 <b>{roleList.length}</b> 类</span>
      <span>名录收录 <b>{total}</b> 人</span>
      <span>晋升 <b>评议与考核</b></span>
    </div>

    <nav class="roster-bar" aria-label="页面章节">
      <a class="chip" href="#ladder">职级阶梯</a>
      <a class="chip" href="#roles">职务分工</a>
      <a class="chip" href={url('/members/')}>成员名录</a>
    </nav>
  </PageHead>

  <section class="wrap section" id="ladder">
    <div class="sec-head">
      <span class="sec-no">01</span>
      <div class="sec-title">
        <h2>{rankList.length} 级职守</h2>
        <p>级别越高，能拍板的事越多，需要让出去的东西也越多。</p>
      </div>
      <span />
    </div>

    <div class="ladder">
      {
        rankList.map((rank) => {
          const holders = membersOfRank(rank.id);
          return (
            <div class="rung" style={`--rc:${rank.color}`}>
              <div class="rung-rail" aria-hidden="true">
                <span class="rung-dot" />
              </div>
              <div class="rung-card">
                <div class="rung-head">
                  {rank.grade && <span class="rung-lv">{rank.grade}</span>}
                  <h2 class="rung-name">{rank.name}</h2>
                  <span class="rung-count">
                    <b>{holders.length}</b> 人
                    {rank.limit ? ` / 上限 ${rank.limit}` : ' / 不限'}
                  </span>
                </div>
                <p class="rung-sum">{rank.summary}</p>

                <div class="rung-cols">
                  <div class="rung-col">
                    <h3>职责</h3>
                    <ul>
                      {rank.duties.map((d) => <li>{d}</li>)}
                    </ul>
                  </div>
                  <div class="rung-col">
                    <h3>晋升</h3>
                    <p>{rank.promotion}</p>
                  </div>
                  <div class="rung-col rung-col--members">
                    <h3>在任</h3>
                    {holders.length > 0 ? (
                      <div class="rung-people">
                        {holders.map((m) => (
                          <a class="rung-person" href={url(`/members/${m.id}/`)} title={m.displayName}>
                            <Avatar seed={m.id} name={m.displayName} src={m.avatar} size="sm" />
                            <span>{m.displayName}</span>
                          </a>
                        ))}
                      </div>
                    ) : (
                      <p class="rung-empty">暂无人在此职级</p>
                    )}
                  </div>
                </div>
              </div>
            </div>
          );
        })
      }
    </div>

    {
      isPlaceholder && (
        <p class="flag-note" style="margin-top:34px">
          <span aria-hidden="true">◆</span>
          {placeholderNotice}
        </p>
      )
    }
  </section>

  <section class="wrap section" id="roles">
    <div class="sec-head">
      <span class="sec-no">02</span>
      <div class="sec-title">
        <h2>{roleList.length} 类职务</h2>
        <p>职务是横向的：一个人可以同时挂着两三个头衔，也可以一个都不挂，只安静地盖房子。</p>
      </div>
      <span class="sec-more">
        <a href={url('/members/')}>按人看 →</a>
      </span>
    </div>

    <div class="role-grid">
      {
        roleList.map((role) => {
          const holders = membersOfRole(role.id);
          return (
            <article class="role-card" id={`role-${role.id}`} style={`--rh:${roleHueOf(role.id)}`}>
              <div class="role-card-head">
                <span class="role-ico" aria-hidden="true">{role.icon || '◇'}</span>
                <h3 class="role-name">{role.name}</h3>
                <span class="role-count">{holders.length} 人</span>
              </div>
              <p class="role-desc">{role.description}</p>
              {holders.length > 0 && (
                <div class="role-holders">
                  {holders.map((m) => (
                    <a class="holder" href={url(`/members/${m.id}/`)}>
                      <Avatar seed={m.id} name={m.displayName} src={m.avatar} size="sm" />
                      <span>{m.displayName}</span>
                    </a>
                  ))}
                </div>
              )}
            </article>
          );
        })
      }
    </div>
  </section>

  <div class="wrap">
    <div class="cta-band">
      <div>
        <h2>想清楚要做哪一种人了？</h2>
        <p>职级可以慢慢升，职务可以随时换。先进来，再谈想去哪个方向。</p>
      </div>
      <a class="btn btn--primary" href={url('/about/#join')}>
        了解加入方式<span class="btn-arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</Base>

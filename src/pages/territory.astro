---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import RegionNode from '../components/RegionNode.astro';
import {
  site,
  territoryList,
  settlementTiers,
  territoriesOfTier,
  isPlaceholder,
  placeholderNotice,
  formatDateFull,
  loreOfPlace,
  adminPlaces,
  rootPlaces,
} from '../lib/loadData';
import { url } from '../lib/url';

const pending = Math.max(0, site.territoryTotal - territoryList.length);
const tierWithItems = settlementTiers
  .map((t) => ({ ...t, list: territoriesOfTier(t.id) }))
  .filter((t) => t.list.length > 0)
  .map((t, i) => ({ ...t, no: String(i + 1).padStart(2, '0') }));
const regionTotal = adminPlaces.length;
const communeCount = adminPlaces.filter((r) => r.tier === 'commune').length;
const rootRegions = rootPlaces.filter((p) => p.tier !== 'locality');
---

<Base
  title="疆域"
  description={`${site.fullName}的 ${site.territoryTotal} 处领地：已下发 ${territoryList.length} 处，另有 ${pending} 处待下发。首府 ${site.capital}。`}
>
  <PageHead
    title="疆域"
    crumb="疆域"
    desc="从凛冬半岛的雪原，到南大陆东方的丘陵，再到隔海相望的雨岛与蒙海。一个公社联盟，是这些地名连起来的样子。"
  >
    <div class="page-meta">
      <span>已下发 <b>{territoryList.length}</b> 处</span>
      <span>待下发 <b>{pending}</b> 处</span>
      <span>合计 <b>{site.territoryTotal}</b> 处</span>
      <span>首府 <b>{site.capital}</b></span>
    </div>

    <nav class="roster-bar" aria-label="按层级跳转">
      <a class="chip" href="#admin">行政区划<b>{regionTotal}</b></a>
      <a class="chip" href="#fiefs">领地台账<b>{territoryList.length}</b></a>
      {
        tierWithItems.map((t) => (
          <a class="chip" href={`#tier-${t.id}`}>
            {t.name}
            <b>{t.list.length}</b>
          </a>
        ))
      }
      {pending > 0 && <a class="chip" href="#pending">待下发<b>{pending}</b></a>}
    </nav>
  </PageHead>

  <section class="wrap section" id="admin">
    <div class="sec-head">
      <span class="sec-no">01</span>
      <div class="sec-title">
        <h2>行政区划</h2>
        <p>中央执行委员会在各地区设立行政公署，任命地区主任代表凛海局领导；地区苏维埃下辖公社，公社享委员级权限、可自治，须服从上级地区。</p>
      </div>
      <span />
    </div>

    <div class="reading-note">
      <span class="reading-note-mark" aria-hidden="true">◈</span>
      <div>
        <strong>怎么读这棵树</strong>
        <p>
          树上三层是权力机关（璃海最高苏维埃 → 凛海局 → 凛海局中央执行委员会），下两层是行政区划（地区苏维埃 →
          公社）。共 {regionTotal} 个节点、{communeCount} 个公社。
        </p>
      </div>
    </div>

    <div class="rgn-tree">
      {rootRegions.map((r) => (
        <RegionNode regionId={r.id} depth={0} />
      ))}
    </div>

    <p class="aside-note rgn-foot-note">
      地区级、公社级为该建制单位相当于凛海局的权限级别，不代表负责人的实际职级；负责人级别可高于地区级别。尚未指定代表的公社，人员补任后此处自动更新。
    </p>
  </section>

  <section class="wrap section" id="fiefs">
    <div class="sec-head">
      <span class="sec-no">02</span>
      <div class="sec-title">
        <h2>领地台账</h2>
        <p>按聚落规模分档的领地台账，与上面的行政区划互为经纬：一套看建制，一套看地盘。</p>
      </div>
      <span />
    </div>

    {
      tierWithItems.map((tier) => (
        <section class="terr-section" id={`tier-${tier.id}`}>
          <div class="terr-head">
            <span class="terr-badge mono">{tier.no}</span>
            <h2>{tier.name}</h2>
            <span class="terr-line" aria-hidden="true" />
            <span class="terr-total mono">{tier.list.length} 处</span>
          </div>
          <div class="terr-cards">
            {tier.list.map((t) => {
              const intro = loreOfPlace(t.id);
              return (
                <article class="terr-card">
                  <div class="terr-card-top">
                    <span class="terr-glyph" aria-hidden="true">◈</span>
                    <h3>
                      {intro ? (
                        <a class="place-link" href={url('/lore/') + '#region-' + intro.id}>
                          {t.name}
                          <span class="place-link-mark" aria-hidden="true">介绍</span>
                        </a>
                      ) : (
                        t.name
                      )}
                    </h3>
                  </div>
                  {t.note && <p class="terr-note">{t.note}</p>}
                </article>
              );
            })}
          </div>
        </section>
      ))
    }
  </section>

  <div class="wrap">
    {
      pending > 0 && (
        <section class="terr-section" id="pending">
          <div class="terr-head">
            <span class="terr-badge mono">待下发</span>
            <h2>已规划，尚未下发</h2>
            <span class="terr-line" aria-hidden="true" />
            <span class="terr-total mono">{pending} 处</span>
          </div>
          <p class="aside-note">
            这些地点的位置与建制已经在册，但要等下发给公社之后才会出现在上面的清单里。
          </p>
        </section>
      )
    }

    {
      isPlaceholder && (
        <p class="flag-note" style="margin-top:36px">
          <span aria-hidden="true">◆</span>
          {placeholderNotice}
        </p>
      )
    }

    <div class="roster-foot">
      <a class="btn btn--ghost" href={url('/about/')}>
        联盟是怎么来的<span class="btn-arrow" aria-hidden="true">→</span>
      </a>
      <a class="btn btn--quiet" href={url('/system/') + '#ranks'}>职级与职务</a>
    </div>
  </div>
</Base>

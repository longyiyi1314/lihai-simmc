---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import OrgNode from '../components/OrgNode.astro';
import {
  site,
  organizationList,
  rootOrganizations,
  orgTiers,
} from '../lib/loadData';

const total = organizationList.length;
const countByTier = (t: string) => organizationList.filter((o) => o.tier === t).length;
const tierChips = orgTiers
  .map((t) => ({ ...t, n: countByTier(t.id) }))
  .filter((t) => t.n > 0);
---

<Base
  title="组织架构"
  description={`${site.fullName}凛海局组织架构：三大委员会及其下属部、局、处，含璃海红军兵团与军区。共 ${total} 个机构。`}
>
  <PageHead
    title="组织架构"
    crumb="组织架构"
    desc="凛海局实行中央执行委员会制，下设计划经济、政务枢机、革命军事三大委员会，逐级统辖部、局、处；武装力量由璃海红军单列。"
  >
    <div class="page-meta">
      <span>机构合计 <b>{total}</b> 个</span>
      {tierChips.map((t) => (
        <span>{t.name} <b>{t.n}</b></span>
      ))}
    </div>
  </PageHead>

  <div class="wrap">
    <div class="org-tree">
      {rootOrganizations.map((o) => (
        <OrgNode orgId={o.id} depth={0} />
      ))}
    </div>

    <p class="aside-note org-foot-note">
      标注「岗位暂缺」者，为架构图中已设编制、尚未指定负责人的机构；人员补任后此处自动更新。
    </p>
  </div>
</Base>

---
import Base from '../../layouts/Base.astro';
import Avatar from '../../components/Avatar.astro';
import RankBadge from '../../components/RankBadge.astro';
import MemberCard from '../../components/MemberCard.astro';
import {
  site,
  memberList,
  rankMap,
  officesOf,
  orgPath,
  orgKindLabel,
  orgHolders,
  membersOfOrg,
  formatMonth,
  statusLabel,
} from '../../lib/loadData';
import { url } from '../../lib/url';
import { padNo, hueOf } from '../../lib/theme';

export function getStaticPaths() {
  return memberList.map((member, i) => ({
    params: { id: member.id },
    props: { member, index: i },
  }));
}

const { member, index } = Astro.props;

const rank = rankMap.get(member.rankId);
const offices = officesOf(member.id);
const hue = hueOf(member.id);

const prev = index > 0 ? memberList[index - 1] : null;
const next = index < memberList.length - 1 ? memberList[index + 1] : null;

const isAlumni = member.status === 'honorary' || member.status === 'left';

/** 同机构里的其他同伴（按共同机构数排序，取前 3） */
const teammates = offices.length
  ? memberList
      .filter((m) => m.id !== member.id)
      .map((m) => ({
        member: m,
        shared: officesOf(m.id).filter((n) => offices.some((o) => o.id === n.id)).length,
      }))
      .filter((x) => x.shared > 0)
      .sort((a, b) => b.shared - a.shared)
      .slice(0, 3)
      .map((x) => x.member)
  : [];

const contacts = Object.entries(member.contacts || {}).filter(([, v]) => Boolean(v));
const contactLabel: Record<string, string> = {
  bilibili: '哔哩哔哩',
  discord: 'Discord',
  qq: 'QQ',
};

const metaRows: Array<{ k: string; v: string; mono?: boolean }> = [
  { k: '游戏 ID', v: member.gameId, mono: true },
  { k: '职级', v: rank?.name ?? member.rankId },
];
if (rank?.grade) metaRows.push({ k: '级别', v: rank.grade });
metaRows.push({ k: '任职机构', v: offices.length ? `${offices.length} 处` : '未记录' });
metaRows.push({ k: '加入时间', v: member.joinedAt ? formatMonth(member.joinedAt) : '未记录', mono: true });
if (member.leftAt) metaRows.push({ k: '离会时间', v: formatMonth(member.leftAt), mono: true });
if (member.updatedAt) metaRows.push({ k: '资料更新', v: member.updatedAt, mono: true });
---

<Base
  title={member.displayName}
  description={`${member.displayName}（${member.gameId}）· ${rank?.name ?? ''} · ${site.nationName}${site.server}成员。${member.intro ? member.intro.slice(0, 60) : `${site.fullName || site.nationName}成员名录中的一页。`}`}
>
  <article class="profile" style={`--h:${hue}`}>
    <div class="wrap">
      <nav class="crumb" aria-label="面包屑">
        <a href={url('/')}>璃海</a>
        <span class="sep" aria-hidden="true">/</span>
        <a href={url('/members/')}>成员</a>
        <span class="sep" aria-hidden="true">/</span>
        <span aria-current="page">{member.displayName}</span>
      </nav>

      <div class="profile-head">
        <div class="profile-main">
          <Avatar seed={member.id} name={member.displayName} src={member.avatar} size="xl" />
          <div class="profile-id">
            <div class="profile-badge-row">
              {rank && <RankBadge rank={rank} size="lg" />}
              <span class={`status status--${member.status}`}>{statusLabel[member.status]}</span>
              <span class="mono profile-no">NO.{padNo(index + 1)}</span>
            </div>
            <h1 class="profile-name">
              {member.displayName}
              {member.title && member.title !== rank?.name && <span class="profile-title">{member.title}</span>}
            </h1>
            <p class="profile-gid">{member.gameId}{rank?.grade ? ` · ${rank.grade}` : ''}</p>
            {
              offices.length > 0 && (
                <div class="profile-tags">
                  {offices.slice(0, 4).map((n) => (
                    <a class="post-tag" href={url(`/org/#org-${n.id}`)}>
                      <span class="post-dot" aria-hidden="true" />
                      {n.name}
                    </a>
                  ))}
                </div>
              )
            }
          </div>
        </div>

        <div class="profile-side">
          <div class="pstat">
            <div class="pstat-k">Joined</div>
            <div class="pstat-v">{member.joinedAt ? member.joinedAt.replace('-', '.') : '—'}</div>
          </div>
          <div class="pstat">
            <div class="pstat-k">{isAlumni ? 'Status' : 'Rank'}</div>
            <div class="pstat-v">{isAlumni ? statusLabel[member.status] : (rank?.name ?? '—')}</div>
          </div>
        </div>
      </div>

      <div class="profile-body">
        <div>
          {
            member.intro ? (
              <div class="prose">
                <p class="dropcap">{member.intro}</p>
              </div>
            ) : (
              <div class="prose">
                <p class="prose-plain">
                  {member.displayName} 目前是{rank?.name ?? '成员'}。个人简介尚未录入——这份名录只保证游戏 ID、职级与机构任职准确，
                  不编造个人经历；等本人或管理层补充后，这里会补上。
                </p>
              </div>
            )
          }

          {
            member.tags.length > 0 && (
              <div class="profile-section">
                <h2 class="panel-title">擅长</h2>
                <div class="tag-list">
                  {member.tags.map((t) => <span class="tag">{t}</span>)}
                </div>
              </div>
            )
          }

          {
            offices.length > 0 && (
              <div class="profile-section">
                <h2 class="panel-title">机构任职</h2>
                <div class="post-list">
                  {offices.map((n) => {
                    const path = orgPath(n.id).slice(1, -1);
                    const self = orgHolders(n.id).find(
                      (h) => h.member?.id === member.id
                    );
                    return (
                      <a class="post-row" href={url(`/org/#org-${n.id}`)}>
                        <span class="post-kind mono">{orgKindLabel[n.kind] ?? n.kind}</span>
                        <span class="post-main">
                          <span class="post-name">{n.name}</span>
                          <span class="post-path">
                            {path.map((p) => p.name).join(' / ') || '凛海局直属'}
                          </span>
                        </span>
                        <span class="post-label">{self?.label || '任职'}</span>
                        <span class="post-arrow" aria-hidden="true">→</span>
                      </a>
                    );
                  })}
                </div>
              </div>
            )
          }

          {
            teammates.length > 0 && (
              <div class="profile-section">
                <h2 class="panel-title">共事的人</h2>
                <div class="mgrid mgrid--compact">
                  {teammates.map((m) => (
                    <MemberCard member={m} showIntro={false} />
                  ))}
                </div>
              </div>
            )
          }
        </div>

        <aside class="profile-aside">
          <div class="panel panel--pad">
            <div class="panel-title">档案</div>
            <div class="meta-list">
              {
                metaRows.map((row) => (
                  <div class="meta-row">
                    <span class="meta-k">{row.k}</span>
                    <span class={`meta-v${row.mono ? ' mono' : ''}`}>{row.v}</span>
                  </div>
                ))
              }
              <div class="meta-row">
                <span class="meta-k">状态</span>
                <span class={`meta-v status status--${member.status}`}>
                  {statusLabel[member.status]}
                </span>
              </div>
            </div>

            {
              contacts.length > 0 && (
                <>
                  <div class="panel-title" style="margin-top:22px">联系</div>
                  <div class="meta-list">
                    {contacts.map(([k, v]) => (
                      <div class="meta-row">
                        <span class="meta-k">{contactLabel[k] ?? k}</span>
                        <span class="meta-v mono">{v}</span>
                      </div>
                    ))}
                  </div>
                </>
              )
            }
          </div>

          <p class="aside-note">
            {isAlumni
              ? '这位同伴已经离开了日常名单，但档案与贡献仍保留在这里。'
              : '资料由本人或管理层维护。这份名录只保证游戏 ID、职级与机构任职准确，简介留白处不做补写；有补充请在群内联系管理层。'}
          </p>

          <a class="aside-back" href={url('/members/')}>
            <span aria-hidden="true">←</span> 返回成员名单
          </a>
        </aside>
      </div>

      <nav class="pager" aria-label="成员翻页">
        {
          prev ? (
            <a class="pager-link" href={url(`/members/${prev.id}/`)}>
              <span class="pager-k">上一位</span>
              <span class="pager-v">{prev.displayName}</span>
            </a>
          ) : (
            <span />
          )
        }
        {
          next ? (
            <a class="pager-link pager-link--next" href={url(`/members/${next.id}/`)}>
              <span class="pager-k">下一位</span>
              <span class="pager-v">{next.displayName}</span>
            </a>
          ) : (
            <span />
          )
        }
      </nav>
    </div>
  </article>
</Base>

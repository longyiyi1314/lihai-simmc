---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import {
  site,
  loreRegions,
  loreNote,
  allLoreWonders,
  placeList,
  loreOfPlace,
} from '../lib/loadData';
import { url } from '../lib/url';

const placeIndex = placeList.map((p) => ({ ...p, intro: loreOfPlace(p.id) }));
---

<Base
  title="风物"
  description={`${site.fullName}的风物地志：地名索引与各地区介绍、莫尔卡瑟堡等奇观。`}
>
  <PageHead
    title="风物"
    crumb="风物"
    desc="山川、圣域与奇观。这片土地上不只有公社与领地，还有它们背后的故事。"
  >
    <div class="page-meta">
      <span>收录地区 <b>{loreRegions.length}</b> 个</span>
      <span>奇观 <b>{allLoreWonders.length}</b> 处</span>
      <span>地名 <b>{placeIndex.length}</b> 处</span>
    </div>

    <nav class="roster-bar" aria-label="按地区跳转">
      <a class="chip" href="#index">地名索引</a>
      {
        loreRegions.map((r) => (
          <a class="chip" href={`#region-${r.id}`}>
            {r.name}
            <b>{r.wonders.length}</b>
          </a>
        ))
      }
    </nav>
  </PageHead>

  <div class="wrap">
    <section class="place-index" id="index">
      <div class="sec-head">
        <span class="sec-no">00</span>
        <div class="sec-title">
          <h2>地名索引</h2>
          <p>全盟地名一览。已录介绍的地名可点击跳转到对应风物条目，未收录的暂付阙如。</p>
        </div>
        <span />
      </div>
      <ul class="place-index-list">
        {
          placeIndex.map((p) => (
            <li>
              {p.intro ? (
                <a class="place-link" href={`#region-${p.intro.id}`}>
                  {p.name}
                  <span class="place-link-mark" aria-hidden="true">介绍</span>
                </a>
              ) : (
                <span class="place-index-none">
                  {p.name}
                  <span class="place-index-tag">暂无介绍</span>
                </span>
              )}
            </li>
          ))
        }
      </ul>
    </section>
    {
      loreRegions.map((region, ri) => (
        <section class="lore-region" id={`region-${region.id}`}>
          <div class="terr-head">
            <span class="terr-badge mono">{String(ri + 1).padStart(2, '0')}</span>
            <h2>{region.name}</h2>
            <span class="terr-line" aria-hidden="true" />
            <span class="terr-total mono">
              {region.area || '地区'}
              {region.wonders.length > 0 && ` · ${region.wonders.length} 处奇观`}
            </span>
          </div>

          {region.summary && (
            <div class="lore-region-sum">
              {region.summary
                .split('\n')
                .filter((s) => s.trim())
                .map((para) => <p>{para}</p>)}
            </div>
          )}

          {region.wonders.map((wonder) => (
            <article class="lore-wonder">
              <header class="lore-wonder-head">
                <div>
                  <div class="lore-wonder-kind mono">
                    <span aria-hidden="true">◈</span>
                    {wonder.kind || '奇观'}
                    {wonder.location && ` · ${wonder.location}`}
                  </div>
                  <h3 class="lore-wonder-name">{wonder.name}</h3>
                </div>
                {wonder.sourceUrl && (
                  <a class="lore-src" href={wonder.sourceUrl} target="_blank" rel="noopener">
                    {wonder.source || '来源'} ↗
                  </a>
                )}
              </header>

              {wonder.summary && (
                <p class="lore-wonder-sum">{wonder.summary}</p>
              )}

              <div class="lore-sections">
                {wonder.sections.map((sec) => (
                  <section class="lore-section">
                    <h4 class="lore-sec-title">{sec.title}</h4>
                    <div class="prose">
                      {sec.blocks.map((b) => {
                        if (b.type === 'bullets')
                          return (
                            <ul class="lore-list">
                              {b.items.map((it) => (
                                <li>{it}</li>
                              ))}
                            </ul>
                          );
                        if (b.type === 'quote')
                          return <blockquote class="lore-quote">{b.body}</blockquote>;
                        if (b.type === 'sub')
                          return (
                            <div class="lore-sub">
                              <h5 class="lore-sub-title">{b.title}</h5>
                              <p>{b.body}</p>
                            </div>
                          );
                        return <p>{b.body}</p>;
                      })}
                    </div>
                  </section>
                ))}
              </div>
            </article>
          ))}
        </section>
      ))
    }

    {
      loreNote && (
        <p class="flag-note" style="margin-top:36px">
          <span aria-hidden="true">◆</span>
          {loreNote}
        </p>
      )
    }

    <div class="roster-foot">
      <a class="btn btn--ghost" href={url('/territory/')}>
        看看疆域与领地<span class="btn-arrow" aria-hidden="true">→</span>
      </a>
      <a class="btn btn--quiet" href={url('/about/')}>联盟是怎么来的</a>
    </div>
  </div>
</Base>
